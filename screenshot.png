just: none; font-family: anthropic-sans, system-ui, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, &quot;PingFang SC&quot;, &quot;PingFang TC&quot;, &quot;Hiragino Sans&quot;, &quot;Apple SD Gothic Neo&quot;, &quot;Kohinoor Devanagari&quot;, &quot;Kohinoor Bangla&quot;, &quot;Kohinoor Telugu&quot;, &quot;Tamil Sangam MN&quot;, &quot;Kohinoor Gujarati&quot;, &quot;Malayalam Sangam MN&quot;, &quot;Nirmala UI&quot;, &quot;Noto Sans Devanagari UI&quot;, &quot;Noto Sans Devanagari&quot;, &quot;Noto Sans Bengali UI&quot;, &quot;Noto Sans Bengali&quot;, &quot;Noto Sans Telugu UI&quot;, &quot;Noto Sans Telugu&quot;, &quot;Noto Sans Tamil UI&quot;, &quot;Noto Sans Tamil&quot;, &quot;Noto Sans Gujarati UI&quot;, &quot;Noto Sans Gujarati&quot;, &quot;Noto Sans Kannada UI&quot;, &quot;Noto Sans Kannada&quot;, &quot;Noto Sans Malayalam UI&quot;, &quot;Noto Sans Malayalam&quot;, Thonburi, &quot;Leelawadee UI&quot;, &quot;Noto Sans Thai UI&quot;, &quot;Noto Sans Thai&quot;, Kefa, Ebrima, &quot;Noto Sans Ethiopic&quot;, &quot;Abyssinica SIL&quot;, sans-serif, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, Roboto, &quot;PingFang SC&quot;, &quot;PingFang TC&quot;, &quot;Hiragino Sans&quot;, &quot;Apple SD Gothic Neo&quot;, sans-serif; text-align: start; text-transform: none; letter-spacing: normal; word-spacing: 0px; tab-size: 4;"><template shadowrootmode="open"><style type="text/css">
.sapling-badge-container {
  position: absolute;
  bottom: 2px;
  right: 0px;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.sapling-status-container {
  position: absolute;
  bottom: 2px;
  right: 2px;
}

.sapling-badge {
  position: absolute;
  width: 8px;
  height: 8px;
  bottom: 8px;
  right: 8px;
  text-align: center;
  border-radius: 50%;
  /* A thin surface-colored halo keeps the dot legible over page text or a
     colored editor background it may overlap. */
  box-shadow: 0 0 0 2px #ffffff;
}

.errors {
  background-color: #8b1a1a;
}

.no-errors {
  background-color: #525f99;
}

.connectivity-error .sapling-badge {
  background-color: #8b1a1a;
}

.throttled-error .sapling-badge {
  background-color: #ffa31a;
}

/* Spinner ring, centered on the dot's position and 2px wider so it reads as
   "working" rather than as a clipped dot. */
.sapling-badge-spinner {
  position: absolute;
  box-sizing: border-box;
  width: 10px;
  height: 10px;
  border: 2px solid #525f99;
  border-top-color: transparent;
  bottom: 7px;
  right: 7px;
  border-radius: 50%;
  animation: rotation 0.9s infinite linear;
}

.connectivity-error .sapling-badge-spinner {
  border-color: #8b1a1a;
  border-top-color: transparent;
}

.sapling-badge-hud {
  position: absolute;
  top: -22px;
  left: -42px;
  transition: all 0.25s;
}

.sapling-tone-hud {
  cursor: pointer;
  pointer-events: initial;
  display: flex;
  transition: all 0.25s;
}

@keyframes rotation {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
</style><style type="text/css">
  .sapling-edit {
    position: absolute;
    box-sizing: content-box;
    display: inline;
    min-width: 0.5em;
    opacity: 0.85;
    background-position: 0px calc(100% + 1px);
    background-repeat: no-repeat;
    background-size: calc(100% + 1px) 2px;
    border-bottom: 2px solid transparent;
    background-image: linear-gradient(to right, #cf222e, #cf222e);
  }

  .sapling-edit:hover {
    background-color: #ffcccc;
    -webkit-transition: background-color 200ms linear;
    -ms-transition: background-color 200ms linear;
    transition: background-color 200ms linear;
  }
