ill="#313f36" fill-rule="evenodd"></path></svg></div></span></div><div class="MuiBox-root extn-css-pud6r9" aria-label="Use AI"><span class="MuiBox-root extn-css-18biwo"><div data-qb-pphr-btn="true" data-testid="qb-pphr-btn" class="PphrContainer__PphrStyledContainer-sc-110nwkl-0 kATfGI"></div></span></div></div></div> </div></template></qb-div></div></qb-div></qb-toolbar></body><sapling-popup-controls><template shadowrootmode="open"><style type="text/css">

.sapling-badge-dash-container {
  position: absolute;
  z-index: 2147483647 !important;
}

/* A white pill of ghost icon buttons. Was a row of solid blue discs carrying
   tiny white raster icons, which read as heavy and hid what each one did. */
.sapling-badge-dash {
  position: relative;
  box-sizing: border-box;
  height: 36px;
  bottom: 2px;
  right: 2px;
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
  gap: 2px;
  padding: 0 4px;
  background-color: #ffffff;
  border: 1px solid #d0d7de;
  border-radius: 18px;
  box-shadow: 0 8px 24px rgb(31 35 40 / 0.16), 0 1px 3px rgb(31 35 40 / 0.12);
}

.sapling-badge-dash > a {
  display: flex;
  text-decoration: none;
}

.connectivity-error .sapling-badge-dash {
  background-color: #ffcccc;
}

.sapling-dashboard-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  color: #525f99;
  cursor: pointer;
  transition: background-color .12s ease, color .12s ease;
}

.sapling-dashboard-icon:hover {
  background-color: #e8eaf6;
  color: #313d66;
}

.sapling-dashboard-icon .sapling-icon {
  display: block;
  flex: none;
}

/* Legacy edit-count button (currently not in ButtonClasses). */
.sapling-button-edit-count {
  background-color: #525f99;
}

/* Stay dark on hover: the generic icon hover tint would put the white count on light blue. */
.sapling-button-edit-count:hover {
  background-color: #313d66;
}

.sapling-button-count {
  position: absolute;
  width: 28px;
  height: 28px;
  color: #ffffff;
  font-weight: 600;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 12px;
  line-height: 28px;
  text-align: center;
  user-select: none;
}

.sapling-button-logo {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 24px;
  height: 24px;
  background-size: cover;
  background-image: url("chrome-extension://gbcfdjgipmpinkahpiambcikjkijimhi/assets/sapling-176x176.svg");
  background-repeat: no-repeat;
}

.sapling-button-tone .top-tone-emoji {
  font-size: 16px;
  line-height: 1;
}

.sapling-button-tone .tooltiptext {
  text-transform: capitalize;
}

/* Over the usage limit: amber, so it stands apart from the regular actions. */
.sapling-button-throttled,
.sapling-button-throttled:hover {
  background-color: #fffbdd;
  color: #9a6600;
}

/* One tooltip rule for every button, centered with a transform instead of a
   per-button width/margin-left table that had to be retuned for each label. */
.tooltiptext {
  visibility: hidden;
  position: absolute;
  z-index: 1;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  max-width: 220px;
  padding: 4px 8px;
  font: 500 12px/1.4 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background-color: #24292f;
  color: #ffffff;
  text-align: center;
  border-radius: 6px;
  user-select: none;
  pointer-events: none;
}

.sapling-dashboard-icon:hover .tooltiptext {
  visibility: visible;
  transition: visibility 0s 300ms;
}

/* SDK option (Sapling.customStyles.badgeTooltipLeft): right-align the tooltip
   to its button so it can't spill off the right edge of an embedding page. */
.tooltiptext.tooltiptext-left {
  left: auto;
  right: 0;
  transform: none;
}

.caret-right::after {
  content: " ";
  position: absolute;
  top: 100%;
  left: 85%;
  margin-left: -4px;
  border-width: 4px;
  border-style: solid;
  border-color: #24292f transparent transparent transparent;
}

.caret-mid::after {
  content: " ";
  position: absolute;
  top: 100%;
  left: 50%;
  margin-left: -4px;
  border-width: 4px;
  border-style: solid;
  border-color: #24292f transparent transparent transparent;
}

.tooltiptext-left.caret-mid::after {
  left: auto;
  right: 10px;
}

</style><div class="sapling-badge-dash-container" style="display: none;"><div class="sapling-badge-dash"><a target="_blank" href="https://sapling.ai/user/sign-in">
      <div class="sapling-dashboard-icon sapling-button-profile">
