 tuo prompt per Claude","loading":"Caricamento in corso..."},"hi-IN":{"greeting":"नमस्ते!","placeholder":"आज मैं आपकी कैसे मदद कर सकता हूं?","aria-label":"Claude को अपना प्रॉम्प्ट लिखें","loading":"लोड हो रहा है..."},"pt-BR":{"greeting":"Que bom ter você aqui!","placeholder":"Como posso ajudar você hoje?","aria-label":"Escreva as instruções para o Claude","loading":"Carregando..."},"id-ID":{"greeting":"Senang Anda ada di sini!","placeholder":"Ada yang bisa saya bantu hari ini?","aria-label":"Tulis prompt Anda ke Claude","loading":"Memuat..."},"am":{"greeting":"እንኳን ደህና መጡ!","placeholder":"ዛሬ እንዴት ልረዳዎት እችላለሁ?","aria-label":"ለClaude ፕሮምፕትዎን ይጻፉ","loading":"በመጫን ላይ..."},"ar":{"greeting":"أهلًا بك!","placeholder":"كيف يمكنني مساعدتك اليوم؟","aria-label":"اكتب مطالبتك إلى Claude","loading":"جارٍ التحميل..."},"be":{"greeting":"Вось і вы!","placeholder":"Чым я магу дапамагчы вам сёння?","aria-label":"Напішыце запыт для Claude","loading":"Загрузка…"},"bho":{"greeting":"आईं, राउर स्वागत बा!","placeholder":"आज हम रउआ के कइसे मदद कर सकीले?","aria-label":"Claude खातिर आपन प्रॉम्प्ट लिखीं","loading":"लोड हो रहल बा..."},"bn":{"greeting":"আপনাকে স্বাগতম!","placeholder":"আজ আমি আপনাকে কীভাবে সাহায্য করতে পারি?","aria-label":"Claude-এর জন্য আপনার প্রম্পট লিখুন","loading":"লোড হচ্ছে…"},"da":{"greeting":"Dejligt at se dig!","placeholder":"Hvordan kan jeg hjælpe dig i dag?","aria-label":"Skriv din prompt til Claude","loading":"Indlæser…"},"fi":{"greeting":"Mukava nähdä!","placeholder":"Miten voin auttaa sinua tänään?","aria-label":"Kirjoita kehotteesi Claudelle","loading":"Ladataan…"},"fil":{"greeting":"Nandito ka na!","placeholder":"Paano kita matutulungan ngayon?","aria-label":"Isulat ang iyong prompt sa Claude","loading":"Naglo-load..."},"gu":{"greeting":"તમારું સ્વાગત છે!","placeholder":"આજે હું તમને કેવી રીતે મદદ કરી શકું?","aria-label":"Claude માટે તમારો પ્રોમ્પ્ટ લખો","loading":"લોડ થઈ રહ્યું..."},"ha":{"greeting":"Barka da zuwa!","placeholder":"Ta yaya zan iya taimaka maka a yau?","aria-label":"Rubuta saƙonka zuwa ga Claude","loading":"Ana lodawa…"},"he":{"greeting":"טוב שבאת!","placeholder":"איך אוכל לעזור לך היום?","aria-label":"כתיבת הפרומפט שלך ל-Claude","loading":"טוען..."},"ig":{"greeting":"Nnọọ!","placeholder":"Kedu ka m ga-esi nyere gị aka taa?","aria-label":"Dee ozi gị nye Claude","loading":"Na-ebute…"},"kn":{"greeting":"ಬನ್ನಿ, ಸ್ವಾಗತ!","placeholder":"ಇಂದು ನಿಮಗೆ ಹೇಗೆ ಸಹಾಯ ಮಾಡಲಿ?","aria-label":"Claude ಗೆ ನಿಮ್ಮ ಪ್ರಾಂಪ್ಟ್ ಬರೆಯಿರಿ","loading":"ಲೋಡ್ ಆಗುತ್ತಿದೆ..."},"ml":{"greeting":"നിങ്ങൾ എത്തിയല്ലോ!","placeholder":"ഇന്ന് ഞാൻ നിങ്ങളെ എങ്ങനെ സഹായിക്കാം?","aria-label":"Claude-ന് നിങ്ങളുടെ പ്രോംപ്റ്റ് എഴുതുക","loading":"ലോഡ് ചെയ്യുന്നു..."},"mr":{"greeting":"या, स्वागत आहे!","placeholder":"आज मी तुम्हाला कशी मदत करू?","aria-label":"Claude साठी तुमचा प्रॉम्प्ट लिहा","loading":"लोड होत आहे..."},"nb":{"greeting":"Der er du!","placeholder":"Hva kan jeg hjelpe deg med i dag?","aria-label":"Skriv ledeteksten din til Claude","loading":"Laster …"},"nl":{"greeting":"Fijn dat je er bent!","placeholder":"Waarmee kan ik je vandaag helpen?","aria-label":"Schrijf je prompt voor Claude","loading":"Laden…"},"ny":{"greeting":"Mwafika!","placeholder":"Ndingakuthandizeni bwanji lero?","aria-label":"Lembani uthenga wanu kwa Claude","loading":"Kutsegula..."},"om":{"greeting":"Baga nagaan dhufte!","placeholder":"Har'a maal si gargaaruu danda'a?","aria-label":"Ergaa kee Claude-f barreessi","loading":"Fe'aa jira..."},"pt-PT":{"greeting":"Que bom ver-te!","placeholder":"Como te posso ajudar hoje?","aria-label":"Escreve o teu prompt para o Claude","loading":"A carregar…"},"rn":{"greeting":"Kaze!","placeholder":"Nokugira iki uyu musi?","aria-label":"Andika ubutumwa bwawe ushaka kurungikira Claude","loading":"Birimwo biraza..."},"ru":{"greeting":"Рады вас видеть!","placeholder":"Чем я могу вам помочь сегодня?","aria-label":"Напишите запрос для Claude","loading":"Загрузка…"},"rw":{"greeting":"Uraho!","placeholder":"Nagufasha iki uyu munsi?","aria-label":"Andika ubutumwa bwawe kuri Claude","loading":"Birimo gupakira..."},"so":{"greeting":"Soo dhawoow!","placeholder":"Sidee kuu caawin karaa maanta?","aria-label":"Qor farriintaada aad u dirayso Claude","loading":"Waa la soo rarayaa..."},"sv":{"greeting":"Kul att du är här!","placeholder":"Hur kan jag hjälpa dig i dag?","aria-label":"Skriv din prompt till Claude","loading":"Läser in…"},"sw":{"greeting":"Karibu!","placeholder":"Nikusaidie nini leo?","aria-label":"Andika ombi lako kwa Claude","loading":"Inapakia..."},"ta":{"greeting":"வாருங்கள்!","placeholder":"இன்று நான் உங்களுக்கு எப்படி உதவலாம்?","aria-label":"Claude-க்கு உங்கள் ப்ராம்ப்டை எழுதவும்","loading":"ஏற்றப்படுகிறது..."},"te":{"greeting":"స్వాగతం!","placeholder":"ఈ రోజు నేను మీకు ఎలా సహాయపడగలను?","aria-label":"Claude కు మీ ప్రాంప్ట్‌ను రాయండి","loading":"లోడ్ అవుతోంది..."},"th":{"greeting":"ดีใจที่ได้เจอคุณ","placeholder":"วันนี้ให้ฉันช่วยอะไรดี","aria-label":"เขียนพรอมต์ของคุณถึง Claude","loading":"กำลังโหลด..."},"tr":{"greeting":"Hoş geldiniz!","placeholder":"Bugün size nasıl yardımcı olabilirim?","aria-label":"Claude’a göndereceğiniz istemi yazın","loading":"Yükleniyor…"},"uk":{"greeting":"Раді вас бачити!","placeholder":"Чим можу допомогти вам сьогодні?","aria-label":"Напишіть свій промпт для Claude","loading":"Завантаження…"},"ur":{"greeting":"خوش آمدید!","placeholder":"آج میں آپ کی کیا مدد کر سکتا ہوں؟","aria-label":"Claude کے لیے اپنا پرامپٹ لکھیں","loading":"لوڈ ہو رہا ہے..."},"vi":{"greeting":"Xin chào!","placeholder":"Hôm nay tôi có thể giúp gì cho bạn?","aria-label":"Viết câu lệnh gửi Claude","loading":"Đang tải..."},"wo":{"greeting":"Dalal ak jàmm!","placeholder":"Naka laa la mën a dimbali tey?","aria-label":"Bindal sa bataaxal ngir Claude","loading":"Mungi yeb…"},"yo":{"greeting":"Kú àbọ̀!","placeholder":"Báwo ni mo ṣe lè ràn ọ́ lọ́wọ́ lónìí?","aria-label":"Kọ ìbéèrè rẹ sí Claude","loading":"Ń gbé wọlé..."},"zh-Hans":{"greeting":"您来啦！","placeholder":"今天我能为您做些什么？","aria-label":"输入您发送给 Claude 的提示词","loading":"正在加载…"},"zh-Hant":{"greeting":"您來啦！","placeholder":"今天我能為您做些什麼？","aria-label":"撰寫您要傳送給 Claude 的提示","loading":"載入中…"}}</script><div id="desktop-boot-drag-strip"></div><script type="application/ld+json">{
